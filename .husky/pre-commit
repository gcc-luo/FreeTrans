# Conditionally invoke so as to avoid running pnpm commands if this is a clean checkout (ie before installing node modules)
if ! [ -d node_modules ]; then
  echo "Skipping $0 hook as node modules are not installed" >&2
  exit 0
fi

echo ""
echo "> quick pre-commit checks (staged JS/TS files only)"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx|mjs|cjs|ts|tsx)$' || true)

if [ -z "$STAGED_FILES" ]; then
  echo "No staged JS/TS files. Skipping eslint."
  exit 0
fi

echo "$STAGED_FILES" | xargs pnpm eslint --cache --max-warnings 0
